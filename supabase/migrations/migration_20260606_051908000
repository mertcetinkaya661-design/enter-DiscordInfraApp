
-- Enable UUID generation
CREATE EXTENSION IF NOT EXISTS "pgcrypto";

-- ─── PROFILES ─────────────────────────────────────────────────────────────────
CREATE TABLE profiles (
  id            UUID PRIMARY KEY REFERENCES auth.users(id) ON DELETE CASCADE,
  username      TEXT UNIQUE NOT NULL,
  display_name  TEXT NOT NULL,
  avatar_url    TEXT,
  status        TEXT NOT NULL DEFAULT 'offline',
  custom_status TEXT,
  created_at    TIMESTAMPTZ NOT NULL DEFAULT NOW()
);

ALTER TABLE profiles ENABLE ROW LEVEL SECURITY;
CREATE POLICY "profiles_select" ON profiles FOR SELECT USING (true);
CREATE POLICY "profiles_update" ON profiles FOR UPDATE USING (auth.uid() = id);
CREATE POLICY "profiles_insert" ON profiles FOR INSERT WITH CHECK (auth.uid() = id);

CREATE OR REPLACE FUNCTION handle_new_user()
RETURNS TRIGGER LANGUAGE plpgsql SECURITY DEFINER AS $$
BEGIN
  INSERT INTO profiles (id, username, display_name)
  VALUES (
    NEW.id,
    COALESCE(NEW.raw_user_meta_data->>'username', split_part(NEW.email, '@', 1)),
    COALESCE(NEW.raw_user_meta_data->>'display_name', split_part(NEW.email, '@', 1))
  )
  ON CONFLICT (id) DO NOTHING;
  RETURN NEW;
END;
$$;

CREATE TRIGGER on_auth_user_created
  AFTER INSERT ON auth.users
  FOR EACH ROW EXECUTE FUNCTION handle_new_user();

-- ─── SERVERS ──────────────────────────────────────────────────────────────────
CREATE TABLE servers (
  id          UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  name        TEXT NOT NULL,
  icon_url    TEXT,
  color       TEXT NOT NULL DEFAULT '#E8722A',
  owner_id    UUID NOT NULL REFERENCES profiles(id) ON DELETE CASCADE,
  invite_code TEXT UNIQUE NOT NULL DEFAULT encode(gen_random_bytes(6), 'hex'),
  created_at  TIMESTAMPTZ NOT NULL DEFAULT NOW()
);

ALTER TABLE servers ENABLE ROW LEVEL SECURITY;

-- ─── SERVER MEMBERS ───────────────────────────────────────────────────────────
CREATE TABLE server_members (
  id        UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  server_id UUID NOT NULL REFERENCES servers(id) ON DELETE CASCADE,
  user_id   UUID NOT NULL REFERENCES profiles(id) ON DELETE CASCADE,
  role      TEXT NOT NULL DEFAULT 'member',
  nickname  TEXT,
  joined_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
  UNIQUE(server_id, user_id)
);

ALTER TABLE server_members ENABLE ROW LEVEL SECURITY;

-- Helper function (SECURITY DEFINER bypasses RLS on server_members)
CREATE OR REPLACE FUNCTION is_server_member(sid UUID, uid UUID)
RETURNS BOOLEAN LANGUAGE sql SECURITY DEFINER STABLE AS $$
  SELECT EXISTS (SELECT 1 FROM server_members WHERE server_id = sid AND user_id = uid)
$$;

CREATE OR REPLACE FUNCTION get_user_server_ids(uid UUID)
RETURNS SETOF UUID LANGUAGE sql SECURITY DEFINER STABLE AS $$
  SELECT server_id FROM server_members WHERE user_id = uid
$$;

-- RLS policies using helper functions
CREATE POLICY "servers_select"  ON servers FOR SELECT  USING (is_server_member(id, auth.uid()));
CREATE POLICY "servers_insert"  ON servers FOR INSERT  WITH CHECK (owner_id = auth.uid());
CREATE POLICY "servers_update"  ON servers FOR UPDATE  USING (owner_id = auth.uid());
CREATE POLICY "servers_delete"  ON servers FOR DELETE  USING (owner_id = auth.uid());

CREATE POLICY "sm_select" ON server_members FOR SELECT USING (server_id IN (SELECT get_user_server_ids(auth.uid())));
CREATE POLICY "sm_insert" ON server_members FOR INSERT WITH CHECK (user_id = auth.uid());
CREATE POLICY "sm_delete" ON server_members FOR DELETE USING (user_id = auth.uid() OR
  EXISTS (SELECT 1 FROM server_members WHERE server_id = server_members.server_id AND user_id = auth.uid() AND role IN ('owner','admin')));

-- ─── CHANNEL CATEGORIES ───────────────────────────────────────────────────────
CREATE TABLE channel_categories (
  id        UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  server_id UUID NOT NULL REFERENCES servers(id) ON DELETE CASCADE,
  name      TEXT NOT NULL,
  position  INT NOT NULL DEFAULT 0
);

ALTER TABLE channel_categories ENABLE ROW LEVEL SECURITY;
CREATE POLICY "cats_select" ON channel_categories FOR SELECT USING (is_server_member(server_id, auth.uid()));
CREATE POLICY "cats_write"  ON channel_categories FOR ALL
  USING (EXISTS (SELECT 1 FROM server_members WHERE server_id = channel_categories.server_id AND user_id = auth.uid() AND role IN ('owner','admin')));

-- ─── CHANNELS ─────────────────────────────────────────────────────────────────
CREATE TABLE channels (
  id          UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  server_id   UUID NOT NULL REFERENCES servers(id) ON DELETE CASCADE,
  category_id UUID REFERENCES channel_categories(id) ON DELETE SET NULL,
  name        TEXT NOT NULL,
  type        TEXT NOT NULL DEFAULT 'text',
  topic       TEXT,
  position    INT NOT NULL DEFAULT 0,
  created_at  TIMESTAMPTZ NOT NULL DEFAULT NOW()
);

ALTER TABLE channels ENABLE ROW LEVEL SECURITY;
CREATE POLICY "channels_select" ON channels FOR SELECT USING (is_server_member(server_id, auth.uid()));
CREATE POLICY "channels_write"  ON channels FOR ALL
  USING (EXISTS (SELECT 1 FROM server_members WHERE server_id = channels.server_id AND user_id = auth.uid() AND role IN ('owner','admin')));

-- ─── MESSAGES ─────────────────────────────────────────────────────────────────
CREATE TABLE messages (
  id         UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  channel_id UUID NOT NULL REFERENCES channels(id) ON DELETE CASCADE,
  author_id  UUID REFERENCES profiles(id) ON DELETE SET NULL,
  content    TEXT NOT NULL,
  edited_at  TIMESTAMPTZ,
  created_at TIMESTAMPTZ NOT NULL DEFAULT NOW()
);

ALTER TABLE messages ENABLE ROW LEVEL SECURITY;

CREATE OR REPLACE FUNCTION message_server_id(channel UUID)
RETURNS UUID LANGUAGE sql SECURITY DEFINER STABLE AS $$
  SELECT server_id FROM channels WHERE id = channel
$$;

CREATE POLICY "messages_select" ON messages FOR SELECT
  USING (is_server_member(message_server_id(channel_id), auth.uid()));
CREATE POLICY "messages_insert" ON messages FOR INSERT
  WITH CHECK (author_id = auth.uid() AND is_server_member(message_server_id(channel_id), auth.uid()));
CREATE POLICY "messages_update" ON messages FOR UPDATE USING (author_id = auth.uid());
CREATE POLICY "messages_delete" ON messages FOR DELETE USING (author_id = auth.uid());

-- ─── DIRECT CONVERSATIONS ─────────────────────────────────────────────────────
CREATE TABLE direct_conversations (
  id         UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  created_at TIMESTAMPTZ NOT NULL DEFAULT NOW()
);

ALTER TABLE direct_conversations ENABLE ROW LEVEL SECURITY;

CREATE TABLE direct_conversation_members (
  conversation_id UUID REFERENCES direct_conversations(id) ON DELETE CASCADE,
  user_id         UUID REFERENCES profiles(id) ON DELETE CASCADE,
  PRIMARY KEY (conversation_id, user_id)
);

ALTER TABLE direct_conversation_members ENABLE ROW LEVEL SECURITY;

CREATE OR REPLACE FUNCTION is_dm_participant(cid UUID, uid UUID)
RETURNS BOOLEAN LANGUAGE sql SECURITY DEFINER STABLE AS $$
  SELECT EXISTS (SELECT 1 FROM direct_conversation_members WHERE conversation_id = cid AND user_id = uid)
$$;

CREATE POLICY "dc_select"  ON direct_conversations FOR SELECT  USING (is_dm_participant(id, auth.uid()));
CREATE POLICY "dc_insert"  ON direct_conversations FOR INSERT  WITH CHECK (true);
CREATE POLICY "dcm_select" ON direct_conversation_members FOR SELECT USING (user_id = auth.uid());
CREATE POLICY "dcm_insert" ON direct_conversation_members FOR INSERT WITH CHECK (true);

-- ─── DIRECT MESSAGES ─────────────────────────────────────────────────────────
CREATE TABLE direct_messages (
  id              UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  conversation_id UUID NOT NULL REFERENCES direct_conversations(id) ON DELETE CASCADE,
  author_id       UUID REFERENCES profiles(id) ON DELETE SET NULL,
  content         TEXT NOT NULL,
  edited_at       TIMESTAMPTZ,
  created_at      TIMESTAMPTZ NOT NULL DEFAULT NOW()
);

ALTER TABLE direct_messages ENABLE ROW LEVEL SECURITY;
CREATE POLICY "dm_select" ON direct_messages FOR SELECT  USING (is_dm_participant(conversation_id, auth.uid()));
CREATE POLICY "dm_insert" ON direct_messages FOR INSERT  WITH CHECK (author_id = auth.uid() AND is_dm_participant(conversation_id, auth.uid()));
CREATE POLICY "dm_delete" ON direct_messages FOR DELETE  USING (author_id = auth.uid());

-- ─── REALTIME ─────────────────────────────────────────────────────────────────
ALTER PUBLICATION supabase_realtime ADD TABLE messages;
ALTER PUBLICATION supabase_realtime ADD TABLE direct_messages;
ALTER PUBLICATION supabase_realtime ADD TABLE profiles;
